{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "RealClear Support",
  "colors": {
    "primary": "#4338CA",
    "light": "#6366F1",
    "dark": "#3730A3"
  },
  "favicon": "/images/favicon.png",
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Reports",
        "pages": [
          "report-progress",
          "reading-a-report",
          "report-tools",
          "properties-and-places"
        ]
      },
      {
        "group": "Evidence",
        "pages": [
          "evidence-and-quotations"
        ]
      },
      {
        "group": "Account",
        "pages": [
          "account-access-and-security",
          "team-and-settings"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "getting-help"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo.png",
    "dark": "/images/logo-white.png",
    "href": "https://realclear.ai"
  },
  "navbar": {
    "links": [
      {
        "href": "https://realclear.ai/contact",
        "label": "Contact RealClear"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/realclearai"
    }
  },
  "description": "Help for ordering, following, and reading RealClear property reports, and for managing your account and workspace.",
  "background": {
    "color": {
      "light": "#FFFCF8",
      "dark": "#0F172A"
    }
  },
  "search": {
    "prompt": "Search RealClear support"
  },
  "seo": {
    "metatags": {
      "canonical": "https://support.realclear.ai"
    },
    "indexing": "navigable"
  },
  "redirects": [
    {
      "source": "/research-queue-and-delivery",
      "destination": "/report-progress"
    },
    {
      "source": "/how-realclear-produces-a-site-memo",
      "destination": "/quickstart"
    },
    {
      "source": "/site-memo-versions-and-withdrawals",
      "destination": "/report-tools"
    },
    {
      "source": "/understanding-a-report",
      "destination": "/reading-a-report"
    },
    {
      "source": "/evidence-citations-and-known-unknowns",
      "destination": "/evidence-and-quotations"
    }
  ]
}
